{
  "name": "pappdrive",
  "version": "0.1.0",
  "description": "A synced, end-to-end encrypted folder for personal apps.",
  "type": "module",
  "bin": {
    "pappdrive": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsup && mkdir -p docs/skill && cp ../../docs/api.md ../../docs/llms.txt docs/ && cp ../../docs/skill/SKILL.md docs/skill/"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "ignore": "7.0.12"
  },
  "optionalDependencies": {
    "@parcel/watcher": "^2.5.0",
    "@napi-rs/keyring": "^1.1.0"
  },
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@pappdrive/protocol": "workspace:*"
  }
}
