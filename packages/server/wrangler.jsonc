{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pappdrive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "sync.pappdrive.com", "custom_domain": true }],

  // D1: plans, users, apps, installs. Schema in src/shared/schema.ts; drizzle-kit generates migrations/.
  "d1_databases": [{ "binding": "DB", "database_name": "pappdrive", "database_id": "8ac9b5d8-bfbb-4d8b-aa64-22d293533368", "migrations_dir": "migrations" }],

  // R2 through the binding: blobs, the index and its kept copies.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pappdrive-prod" }],

  // One Durable Object per folder, named "<user>/<app>": the commit queue.
  "durable_objects": { "bindings": [{ "name": "FOLDER", "class_name": "FolderQueue" }] },
  // Since July 2026 new Durable Object classes must use SQLite storage, even
  // one that stores nothing. new_classes fails on deploy.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FolderQueue"] }],

  // Sign-in style routes: params, signup, login, recover, app/delete,
  // account/delete. Counted per Cloudflare location. period must be 10 or 60;
  // the code answers Retry-After: 60.
  "ratelimits": [
    { "name": "RL_EMAIL", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_IP", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    // Blob uploads, per user.
    { "name": "RL_UPLOAD", "namespace_id": "4103", "simple": { "limit": 600, "period": 60 } },
  ],

  // Email verification codes, from noreply@pappdrive.com (onboarded in Email Service).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@pappdrive.com"] }],

  // Secrets (wrangler secret put): TOKEN_KEY, and TOKEN_KEY_OLD only while rotating.
}
